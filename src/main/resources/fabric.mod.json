{
  "schemaVersion": 1,
  "id": "eldensteve",
  "version": "${version}",
  "name": "Elden Flow",
  "description": "Elden Flow: movement, combat and campfire progression. Development build; dedicated combat integration in progress.",
  "authors": [
    "EldenMinecraftProject"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.eldensteve.EldenFlow"],
    "client": [
      "dev.eldensteve.EldenSteveClient"
    ],
    "controlify": [
      "dev.eldensteve.ControlifyBridge"
    ],
    "modmenu": [
      "dev.eldensteve.EldenModMenu"
    ]
  },
  "mixins": [
    "eldensteve.mixins.json",
    {
      "config": "eldensteve.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  },
  "icon": "assets/eldensteve/icon.png"
}
